# Settings library only. Everything else stays on this Mac.
*
!/.gitignore
!/README.md
!/AGENTS.md
!/Sound Library/
!/Sound Library/*/
!/Sound Library/*/README.md
!/Sound Library/*/settings.json
!/Sound Library/*/manifest.sha256
!/Sound Library/*/*.patch/
!/Sound Library/*/*.patch/data.plist
!/Sound Library/*/*.patch/com.apple.musicapps.metadata.plist
!/Sound Library/*/*.patch/\#Root.cst

# Exact Focusrite settings snapshot; no global application settings.
!/Hardware/
!/Hardware/Focusrite Scarlett 4i4/
!/Hardware/Focusrite Scarlett 4i4/README.md
!/Hardware/Focusrite Scarlett 4i4/settings.json
!/Hardware/Focusrite Scarlett 4i4/manifest.sha256
!/Hardware/Focusrite Scarlett 4i4/Bass Flute - GarageBand - 68 dB.xml

# Sentral Music production notes and settings only.
!/Sentral Music/
!/Sentral Music/README.md
!/Sentral Music/Layla/
!/Sentral Music/Layla/README.md
!/Sentral Music/Layla/settings.json
